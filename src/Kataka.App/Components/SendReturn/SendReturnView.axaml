<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kataka.App.ViewModels"
             xmlns:controls="using:Kataka.App.Controls"
             x:Class="Kataka.App.Views.SendReturnView"
             x:DataType="vm:SendReturnViewModel"
             x:CompileBindings="False">

    <Border Classes="panel-section" Padding="12,10">
        <StackPanel Spacing="8">

            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="SEND/RETURN"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" />
                <ToggleButton Classes="effect-button"
                              Content="ON"
                              Width="52"
                              IsChecked="{Binding IsEnabled}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="MODE" VerticalAlignment="Center" FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}" />
                <ComboBox Classes="pedal-type-picker"
                          SelectedIndex="{Binding Mode.Value}"
                          Width="130">
                    <ComboBoxItem Content="SEND/RETURN" />
                    <ComboBoxItem Content="RETURN ONLY" />
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <controls:RotaryKnobV2 Label="SEND"
                                       Scale="0.65"
                                       LabelFontSize="13"
                                       ValueFontSize="12"
                                       Minimum="0" Maximum="100"
                                       Value="{Binding SendLevel.Value}" />
                <controls:RotaryKnobV2 Label="RETURN"
                                       Scale="0.65"
                                       LabelFontSize="13"
                                       ValueFontSize="12"
                                       Minimum="0" Maximum="100"
                                       Value="{Binding ReturnLevel.Value}" />
            </StackPanel>

        </StackPanel>
    </Border>

</UserControl>
